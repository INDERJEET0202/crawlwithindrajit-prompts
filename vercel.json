{
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/prompt.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "(?<slug>[a-z0-9-]+)"
        }
      ],
      "destination": "/prompts/:slug/",
      "permanent": true
    }
  ]
}
